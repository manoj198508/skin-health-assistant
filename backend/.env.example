AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:latest
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# For cloud deployments (set AI_PROVIDER=openai) - costs money, requires billing on your
# OpenAI account
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Free alternative to OpenAI (set AI_PROVIDER=gemini) - get a free key with no credit card
# at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

AI_TIMEOUT_SECONDS=90

DATABASE_URL=sqlite:///./skin_health.db
CORS_ORIGINS=http://localhost:5173
IMAGE_TTL_HOURS=24
MAX_IMAGE_MB=8

# Leave empty for frictionless local development. Set this before exposing the backend
# publicly (e.g. via a tunnel) - visitors must then pass this exact value in an
# X-Access-Code header (the frontend's access-code screen handles this) before they can
# chat or analyze photos.
ACCESS_CODE=
